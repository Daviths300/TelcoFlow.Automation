        {
          "name": "reconciliation",
          "item": [
            {
              "name": "payments",
              "item": [
                {
                  "name": "{transaction_id}",
                  "item": [
                    {
                      "name": "Reconcile Payment",
                      "event": [
                        {
                          "listen": "test",
                          "script": {
                            "exec": [
                              "pm.test(\"Status code is 200\", function () {\r",
                              "    pm.response.to.have.status(200);\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Response source is SQL Server\", function () {\r",
                              "    const body = pm.response.json();\r",
                              "\r",
                              "    pm.expect(body.source).to.eql(\"sql-server\");\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Billing anomaly is detected\", function () {\r",
                              "    const result = pm.response.json().reconciliation;\r",
                              "\r",
                              "    pm.expect(result.anomaly_detected).to.eql(true);\r",
                              "    pm.expect(result.anomaly_code)\r",
                              "        .to.eql(\"BILLING_ENTRY_MISSING\");\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Severity and priority are correct\", function () {\r",
                              "    const result = pm.response.json().reconciliation;\r",
                              "\r",
                              "    pm.expect(result.severity).to.eql(\"HIGH\");\r",
                              "    pm.expect(result.priority).to.eql(\"P0\");\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Correlation ID remains consistent\", function () {\r",
                              "    const body = pm.response.json();\r",
                              "\r",
                              "    pm.expect(body.payment_state.correlation_id)\r",
                              "        .to.eql(body.reconciliation.correlation_id);\r",
                              "\r",
                              "    pm.expect(body.payment_state.correlation_id)\r",
                              "        .to.eql(\"CORR-2026-DB-0001\");\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Evidence confirms the inconsistency\", function () {\r",
                              "    const evidence =\r",
                              "        pm.response.json().reconciliation.evidence;\r",
                              "\r",
                              "    pm.expect(evidence.bank_status).to.eql(\"SUCCESS\");\r",
                              "    pm.expect(evidence.payment_service_status)\r",
                              "        .to.eql(\"SUCCESS\");\r",
                              "\r",
                              "    pm.expect(evidence.billing_entry_exists)\r",
                              "        .to.eql(false);\r",
                              "\r",
                              "    pm.expect(evidence.subscriber_balance_updated)\r",
                              "        .to.eql(false);\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Recommended action is provided\", function () {\r",
                              "    const action =\r",
                              "        pm.response.json()\r",
                              "            .reconciliation\r",
                              "            .recommended_action;\r",
                              "\r",
                              "    pm.expect(action)\r",
                              "        .to.be.a(\"string\")\r",
                              "        .and.not.empty;\r",
                              "});\r",
                              "\r",
                              "pm.test(\"Response time is below 2000 ms\", function () {\r",
                              "    pm.expect(pm.response.responseTime)\r",
                              "        .to.be.below(2000);\r",
                              "});"
                            ],
                            "type": "text/javascript",
                            "packages": {},
                            "requests": {}
                          }
                        }
