                {
                  "name": "Get Unknown Payment — 404",
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "exec": [
                          "pm.test(\"Unknown transaction returns 404\", function () {\r",
                          "    pm.response.to.have.status(404);\r",
                          "});\r",
                          "\r",
                          "pm.test(\"Error response is valid JSON\", function () {\r",
                          "    const contentType = pm.response.headers.get(\"Content-Type\");\r",
                          "\r",
                          "    pm.expect(contentType).to.include(\"application/json\");\r",
                          "\r",
                          "    pm.expect(function () {\r",
                          "        pm.response.json();\r",
                          "    }).not.to.throw();\r",
                          "});\r",
                          "\r",
                          "pm.test(\"Error identifies the missing transaction\", function () {\r",
                          "    const body = pm.response.json();\r",
                          "\r",
                          "    pm.expect(body.detail).to.be.a(\"string\");\r",
                          "    pm.expect(body.detail)\r",
                          "        .to.include(\"Transaction was not found\");\r",
                          "\r",
                          "    pm.expect(body.detail)\r",
                          "        .to.include(\"TXN-DOES-NOT-EXIST\");\r",
                          "});\r",
                          "\r",
                          "pm.test(\"Response time is below 2000 ms\", function () {\r",
                          "    pm.expect(pm.response.responseTime)\r",
                          "        .to.be.below(2000);\r",
